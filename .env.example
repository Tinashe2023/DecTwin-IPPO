# Copy this file to `.env` (same folder as the scripts). It is loaded automatically via python-dotenv.
# `.env` is git-ignored: never commit or upload it.
DB_PASSWORD=your_postgres_password

# Optional database overrides (defaults shown)
# DB_NAME=dectwin
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5433

# Optional: enables Weights & Biases logging in the train*.py scripts. Leave empty for console logging only.
WANDB_API_KEY=
